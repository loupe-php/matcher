{
    "name": "loupe/matcher",
    "description": "Tokenize, decompose, highlight and crop around text and search terms",
    "keywords": ["search", "tokenize", "tokenizer", "crop", "highlight", "decomposition", "decompose", "dictionary"],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Loupe\\Matcher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Loupe\\Matcher\\Build\\": "build/",
            "Loupe\\Matcher\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Yanick Witschi",
            "email": "yanick.witschi@terminal42.ch"
        },
        {
            "name": "Philipp Daun",
            "email": "daun@daun.ltd"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-zlib": "*",
        "toflar/fast-set": "^1.0"
    },
    "require-dev": {
        "phpbench/phpbench": "^1.2",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5.46",
        "symfony/console": "^6.4 || ^7.4 || ^8.0",
        "symfony/filesystem": "^6.4 || ^7.4 || ^8.0",
        "symfony/finder": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/var-dumper": "^6.4 || ^7.4 || ^8.0",
        "terminal42/code-quality-tools": "dev-main"
    },
    "scripts": {
        "tests": "@php vendor/bin/phpunit",
        "bench": "@php vendor/bin/phpbench run --report=tokenizer",
        "cs-fixer": "@php vendor/terminal42/code-quality-tools/tools/ecs/vendor/bin/ecs check build src tests --config vendor/terminal42/code-quality-tools/tools/ecs/config.php --fix --ansi",
        "rector": "@php vendor/terminal42/code-quality-tools/tools/rector/vendor/bin/rector process build src tests --config vendor/terminal42/code-quality-tools/tools/rector/config.php --ansi",
        "phpstan": "@php vendor/terminal42/code-quality-tools/tools/phpstan/vendor/bin/phpstan analyze build src tests --configuration vendor/terminal42/code-quality-tools/tools/phpstan/config.php --ansi",
        "ci-code-quality": [
            "@cs-fixer",
            "@rector",
            "@phpstan"
        ]
    },
    "config": {
        "allow-plugins": {
            "terminal42/code-quality-tools": true
        }
    }
}
